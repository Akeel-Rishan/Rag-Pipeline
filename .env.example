# Read from process environment; .env files are NOT loaded automatically.
# Leave URL unset to use persistent local mode.
QDRANT_PATH=.qdrant
QDRANT_COLLECTION=hybrid_rag_bge_small_v1
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your-key-here
# OpenAI-compatible chat endpoint. Defaults target a local Ollama server.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
# LLM_API_KEY=your-key-here
LLM_TIMEOUT_SECONDS=60
# Never commit real API keys.
